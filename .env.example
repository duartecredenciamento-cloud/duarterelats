# Porta opcional
PORT=8000

# Integração Azure AI Foundry (opcional; desativada por padrão).
# Obtenha endpoint, deployment, versão e chave pela TI; nunca comite segredos.
AZURE_OPENAI_ENDPOINT=https://SEU-RECURSO.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=SEU_DEPLOYMENT
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_API_KEY=
DUARTE_AI_ANALYSIS_ENABLED=false

# Proteção de acesso à rota de IA/exportação executiva. Gere valor aleatório forte.
DUARTE_AI_ACCESS_TOKEN=

# Atenção: este gate técnico NÃO substitui login Microsoft Entra, sessões por usuário,
# autorização de caixa, proteção CSRF ou isolamento multiusuário para produção.
# Não habilite análise de conteúdo antes da aprovação da TI/DPO e desses controles.
